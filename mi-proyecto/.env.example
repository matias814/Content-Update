# Intercom API token — Settings → Developers → Access Token
INTERCOM_TOKEN=your_intercom_access_token_here

# ID of the "Campaign deadline dates" internal article.
# Leave blank on the first run — the script will create the article and print its ID.
# Paste that ID here before the next run so every sync updates the same article.
ARTICLE_ID=

# Optional: cron schedule (default: 06:00 AM UTC daily)
# CRON_SCHEDULE=0 6 * * *

# Optional: timezone for the cron schedule (default: UTC)
# CRON_TIMEZONE=America/New_York
